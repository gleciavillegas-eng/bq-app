<article class="product-card" data-category="{{ product.category|lower }}">

    <div class="product-card-image">
        {% if product.image %}
            <img src="/{{ product.image }}" alt="{{ product.name }}" loading="lazy">
        {% else %}
            <div style="height:100%;display:flex;align-items:center;justify-content:center;font-size:64px;">🍔</div>
        {% endif %}
    </div>

    <div class="product-card-content">
        <span class="product-category">{{ product.category }}</span>

        <h3>{{ product.name }}</h3>

        {% if product.description %}
            <p>{{ product.description }}</p>
        {% endif %}

        <div class="product-card-bottom">
            <strong class="product-price">₱{{ product.price|number_format(2) }}</strong>
            <a href="/order-now?product={{ product.id }}" class="primary-btn">Order Now</a>
        </div>
    </div>

</article>